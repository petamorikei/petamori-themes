  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#a07589",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comment",
      "scope": ["comment.block.documentation", "comment.line.documentation", "comment.line.double-slash.documentation"],
      "settings": {
        "foreground": "#9a6f83",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#006c46"
      }
    },
    {
      "name": "String escape",
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": {
        "foreground": "#c50068"
      }
    },
    {
      "name": "Regular expression",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#765a00"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric", "keyword.other.unit"],
      "settings": {
        "foreground": "#765a00"
      }
    },
    {
      "name": "Constant",
      "scope": ["constant.language", "constant.other", "variable.other.constant", "support.constant"],
      "settings": {
        "foreground": "#765a00"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#c50068"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": {
        "foreground": "#915070"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#82596c"
      }
    },
    {
      "name": "Template expression",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": {
        "foreground": "#944a00"
      }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": {
        "foreground": "#944a00"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#7d4fab"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#c50068"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator"],
      "settings": {
        "foreground": "#7d4fab"
      }
    },
    {
      "name": "Preprocessor",
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": {
        "foreground": "#7d4fab"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other.readwrite"],
      "settings": {
        "foreground": "#613a4d"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameter variable"],
      "settings": {
        "foreground": "#82542b"
      }
    },
    {
      "name": "Special variable",
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#c50068",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#95454e"
      }
    },
    {
      "name": "Namespace",
      "scope": ["entity.name.namespace", "entity.name.module", "entity.name.package"],
      "settings": {
        "foreground": "#7b5265"
      }
    },
    {
      "name": "Enum member",
      "scope": ["variable.other.enummember", "constant.other.enum", "entity.name.label"],
      "settings": {
        "foreground": "#5b569b"
      }
    },
    {
      "name": "CSS selector",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css"],
      "settings": {
        "foreground": "#765a00"
      }
    },
    {
      "name": "CSS pseudo selector",
      "scope": ["entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element"],
      "settings": {
        "foreground": "#7d4fab"
      }
    },
    {
      "name": "Heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#c50068",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#765a00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#c50068",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Link URL",
      "scope": ["markup.underline.link", "markup.link"],
      "settings": {
        "foreground": "#006a58"
      }
    },
    {
      "name": "Link text",
      "scope": ["string.other.link"],
      "settings": {
        "foreground": "#5b569b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"],
      "settings": {
        "foreground": "#006c46"
      }
    },
    {
      "name": "List marker",
      "scope": ["punctuation.definition.list.begin", "markup.list punctuation.definition.list"],
      "settings": {
        "foreground": "#c50068"
      }
    },
    {
      "name": "Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#82596c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#006c46"
      }
    },
    {
      "name": "Deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#bb3300"
      }
    },
    {
      "name": "Changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#765a00"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#bb3300"
      }
    }
  ],
