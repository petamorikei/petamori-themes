  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#85727c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comment",
      "scope": ["comment.block.documentation", "comment.line.documentation", "comment.line.double-slash.documentation"],
      "settings": {
        "foreground": "#9e8b95",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#b7d19d"
      }
    },
    {
      "name": "String escape",
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": {
        "foreground": "#ed9ebf"
      }
    },
    {
      "name": "Regular expression",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#edc18b"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric", "keyword.other.unit"],
      "settings": {
        "foreground": "#edc18b"
      }
    },
    {
      "name": "Constant",
      "scope": ["constant.language", "constant.other", "variable.other.constant", "support.constant"],
      "settings": {
        "foreground": "#edc18b"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#ed9ebf"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": {
        "foreground": "#c29dae"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#b5a2ac"
      }
    },
    {
      "name": "Template expression",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": {
        "foreground": "#f9baa4"
      }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": {
        "foreground": "#f9baa4"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#c5a9ee"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#ed9ebf"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator"],
      "settings": {
        "foreground": "#c5a9ee"
      }
    },
    {
      "name": "Preprocessor",
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": {
        "foreground": "#c5a9ee"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other.readwrite"],
      "settings": {
        "foreground": "#e8d4de"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameter variable"],
      "settings": {
        "foreground": "#e6c1ad"
      }
    },
    {
      "name": "Special variable",
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#ed9ebf",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#e9bec8"
      }
    },
    {
      "name": "Namespace",
      "scope": ["entity.name.namespace", "entity.name.module", "entity.name.package"],
      "settings": {
        "foreground": "#d8c3ce"
      }
    },
    {
      "name": "Enum member",
      "scope": ["variable.other.enummember", "constant.other.enum", "entity.name.label"],
      "settings": {
        "foreground": "#b0caf4"
      }
    },
    {
      "name": "CSS selector",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css"],
      "settings": {
        "foreground": "#edc18b"
      }
    },
    {
      "name": "CSS pseudo selector",
      "scope": ["entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element"],
      "settings": {
        "foreground": "#c5a9ee"
      }
    },
    {
      "name": "Heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#e9a1be",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#edc18b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#e9a1be",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Link URL",
      "scope": ["markup.underline.link", "markup.link"],
      "settings": {
        "foreground": "#97d4cb"
      }
    },
    {
      "name": "Link text",
      "scope": ["string.other.link"],
      "settings": {
        "foreground": "#b0caf4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"],
      "settings": {
        "foreground": "#b7d19d"
      }
    },
    {
      "name": "List marker",
      "scope": ["punctuation.definition.list.begin", "markup.list punctuation.definition.list"],
      "settings": {
        "foreground": "#ed9ebf"
      }
    },
    {
      "name": "Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#b5a2ac",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#b7d19d"
      }
    },
    {
      "name": "Deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#f88670"
      }
    },
    {
      "name": "Changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#edc18b"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#f88670"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#d8c3ce",
    "class": "#c5a9ee",
    "struct": "#c5a9ee",
    "interface": "#c5a9ee",
    "type": "#c5a9ee",
    "typeParameter": "#c5a9ee",
    "enum": "#c5a9ee",
    "enumMember": "#b0caf4",
    "function": "#f9baa4",
    "method": "#f9baa4",
    "macro": "#c5a9ee",
    "decorator": "#c5a9ee",
    "parameter": "#e6c1ad",
    "variable": "#e8d4de",
    "property": "#e9bec8",
    "label": "#b0caf4",
    "keyword": "#ed9ebf",
    "comment": {
      "foreground": "#85727c",
      "fontStyle": "italic"
    },
    "string": "#b7d19d",
    "number": "#edc18b",
    "regexp": "#edc18b",
    "operator": "#c29dae",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
